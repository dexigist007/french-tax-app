{
  "name": "fastfood-cost-app",
  "version": "1.0.0",
  "description": "Outil local et chiffré de calcul des coûts, de prix de vente et de rentabilité pour la restauration rapide en France.",
  "main": "electron/main.js",
  "type": "module",
  "author": "Open Source Contributor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/french-tax-app"
  },
  "keywords": [
    "fast-food",
    "restauration rapide",
    "food cost",
    "fiche technique",
    "marge",
    "compte de résultat",
    "ingénierie de menu",
    "local-first"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.fastfoodcost.app",
    "productName": "Fast-Food Coût & Marge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/share": "^8.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "fast-check": "^4.5.3",
    "idb": "^8.0.3",
    "jspdf": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
